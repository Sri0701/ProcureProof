# Copy to .env at the repo root. Never commit .env.
# The server refuses to start if any required variable is missing or invalid.

# HTTP
PORT=4010
NODE_ENV=development
FRONTEND_URL=http://localhost:5180

# At least 32 characters. Used to sign JWTs. Generate a new value for every environment.
JWT_SECRET=

# Google Gemini. Server only. Never put this in the client or in git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase. The service role key bypasses RLS. Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# Shared demo account created on boot in a later phase.
DEMO_EMAIL=demo@procureproof.app
DEMO_PASSWORD=

# Client (Vite). Leave VITE_API_URL empty in local dev so requests go through the Vite proxy.
# On Vercel set it to the Render API origin, with no trailing slash.
VITE_API_URL=
VITE_ENABLE_BOXES=false
